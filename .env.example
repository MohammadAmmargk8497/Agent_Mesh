# Copy to .env (chmod 600); replace every placeholder privately before starting.
# Reuse the existing agent tokens so agent client configurations stay unchanged.
# Each agent token must be unique and at least 32 characters long.
AGENT_A_TOKEN=replace-with-existing-agent-a-token-at-least-32-characters
AGENT_B_TOKEN=replace-with-existing-agent-b-token-at-least-32-characters
# Existing remotely managed tunnel: public hostname -> http://app:8787.
TUNNEL_TOKEN=replace-with-existing-cloudflare-tunnel-token
AGENTMESH_PUBLIC_URL=https://agents.zahid.win
